{
  "entities": {
    "Chapter": {
      "title": "Chapter",
      "description": "A generated chapter of the story",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chapterNumber": { "type": "number" },
        "title": { "type": "string" },
        "cefrLevel": { "type": "string" },
        "grammarFocus": { "type": "string" },
        "episodeJob": { "type": "string" },
        "logline": { "type": "string" },
        "aStory": { "type": "string" },
        "bStory": { "type": "string" },
        "cStory": { "type": "string" },
        "coreLanguageTarget": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "storyBeats": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "emotionalMovement": { "type": "string" },
        "writerNotes": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "storyText": { "type": "string" },
        "wordBankJson": { 
          "type": "array", 
          "description": "Array of word objects",
          "items": { "type": "object" }
        },
        "grammarLessonText": { "type": "string" },
        "continuitySummary": { "type": "string" },
        "isGeneratingExtras": { "type": "boolean" },
        "isGeneratingWordBank": { "type": "boolean" },
        "isGeneratingGrammar": { "type": "boolean" },
        "wordCount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "generating", "complete", "failed", "final"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["id", "chapterNumber", "title", "cefrLevel", "grammarFocus", "wordCount", "status", "createdAt", "updatedAt", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}/chapters/{chapterId}": {
      "schema": { "$ref": "#/entities/Chapter" },
      "description": "Chapters generated by the user"
    }
  }
}
